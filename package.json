      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "billing",
    "cost",
    "token-usage",
    "deepseek"
  ],
  "license": "MIT",
  "author": "jiutianyisui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiutianyisui/dsh-billing.git"
  },
  "bugs": {
    "url": "https://github.com/jiutianyisui/dsh-billing/issues"
  },
  "homepage": "https://github.com/jiutianyisui/dsh-billing#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1",
    "test": "node ./tests/smoke.mjs && node ./tests/host.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  }
