{
  "name": "dsh-billing",
  "version": "0.1.0",
  "description": "DSH 计费显示：在模型选择器旁边显示账户余额、本会话总花费与每步花费（￥）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
